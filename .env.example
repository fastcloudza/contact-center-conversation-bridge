# Server
PORT=8080
LOG_LEVEL=info

# Inbound auth (shared by every push-triggered adapter)
INBOUND_API_KEY_HEADER=x-api-key
INBOUND_API_KEY=change-me-to-a-long-random-value

# Outbound webhook (shared by every adapter)
# The default below points at scripts/demo-receiver.ts, change it once
# you're pointing at something real.
OUTBOUND_WEBHOOK_URL=http://localhost:4000/receive
OUTBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-value
OUTBOUND_WEBHOOK_TIMEOUT_MS=5000

# Optional. Identifiers your receiver uses for the business. They are copied
# into every payload as waba_id, waba_phone and country_code. The phone is the
# business display number in international format, for example +15551234567.
RECEIVER_BUSINESS_ID=
RECEIVER_BUSINESS_PHONE=
RECEIVER_COUNTRY_CODE=

# Amazon Connect adapter
AMAZON_CONNECT_ENABLED=true

# Set to true to try the whole Amazon Connect path with zero AWS account,
# zero credentials, zero real Contact Lens call. See README's "Try it
# without AWS" section. Never set this in a real deployment.
AMAZON_CONNECT_DEMO_MODE=false
DEMO_RECEIVER_PORT=4000

AMAZON_CONNECT_AWS_REGION=us-east-1
# Optional. If omitted, the AWS SDK's default credential provider chain is
# used (instance role, ECS task role, shared credentials file, etc).
AMAZON_CONNECT_AWS_ACCESS_KEY_ID=
AMAZON_CONNECT_AWS_SECRET_ACCESS_KEY=

# Only objects whose S3 key starts with one of these prefixes are processed.
# Several prefixes can be given, separated by commas. In the one test
# bucket checked, analysis files sat at the top of the bucket under Analysis/.
AMAZON_CONNECT_ANALYSIS_PATH_PREFIX=Analysis/Voice/,Analysis/Chat/

# CTR (Contact Trace Record) enrichment, optional, see README.
#   none: do not attempt CTR enrichment (default)
#   s3:   look up a CTR JSON object in S3 by ContactId
AMAZON_CONNECT_CTR_RESOLVER=none
AMAZON_CONNECT_CTR_S3_BUCKET=
AMAZON_CONNECT_CTR_S3_PREFIX=ContactTraceRecords/

# Genesys Cloud adapter
# Not wired into the server (it's pull-based, see
# src/adapters/genesysCloud/README.md). These are only read by
# src/adapters/genesysCloud/fetch-and-ingest-example.ts.
GENESYS_LOGIN_BASE_URL=
GENESYS_API_BASE_URL=
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
