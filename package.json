{
  "name": "contact-center-conversation-bridge",
  "version": "1.0.0",
  "description": "Normalizes speaker-attributed transcripts from contact-center platforms (Amazon Connect Contact Lens, Genesys Cloud, and more) into one channel-agnostic shape, and forwards it to a configurable webhook.",
  "license": "MIT",
  "author": {
    "name": "Arno Hart",
    "url": "https://github.com/fastcloudza"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "demo:receiver": "tsx scripts/demo-receiver.ts",
    "demo:replay": "tsx scripts/replay-event.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
